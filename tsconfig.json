{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@amg-webui": ["packages/index.ts"],
      "@amg-webui/*": ["packages/*"],
      "@amg-webui/components": ["packages/components/index.ts"],
      "@amg-webui/components/base": ["packages/components/base/index.ts"],
      "@amg-webui/components/business": ["packages/components/business/index.ts"],
      "@amg-webui/business": ["packages/components/business/index.ts"],
      "@amg-webui/core": ["packages/components/core/index.ts"],
      "@amg-webui/core/*": ["packages/components/core/*"],
      "@amg-webui/form": ["packages/components/form/index.ts"],
      "@amg-webui/form/*": ["packages/components/form/*"],
      "@amg-webui/data": ["packages/components/data/index.ts"],
      "@amg-webui/data/*": ["packages/components/data/*"],
      "@amg-webui/overlay": ["packages/components/overlay/index.ts"],
      "@amg-webui/overlay/*": ["packages/components/overlay/*"],
      "@amg-webui/charts": ["packages/components/charts/index.ts"],
      "@amg-webui/charts/*": ["packages/components/charts/*"],
      "@amg-webui/editor": ["packages/components/editor/index.ts"],
      "@amg-webui/editor/*": ["packages/components/editor/*"],
      "@amg-webui/media": ["packages/components/media/index.ts"],
      "@amg-webui/media/*": ["packages/components/media/*"],
      "@amg-webui/gb28181": ["packages/components/gb28181/index.ts"],
      "@amg-webui/gb28181/*": ["packages/components/gb28181/*"],
      "@amg-webui/onvif": ["packages/components/onvif/index.ts"],
      "@amg-webui/onvif/*": ["packages/components/onvif/*"],
      "@amg-webui/hooks": ["packages/hooks/index.ts"],
      "@amg-webui/telemetry": ["packages/telemetry/index.ts"],
      "@amg-webui/security": ["packages/security/index.ts"],
      "@amg-webui/lowcode": ["packages/lowcode/index.ts"],
      "@amg-webui/lowcode/*": ["packages/lowcode/*"],
      "@amg-webui/runtime": ["packages/runtime/index.ts"],
      "@amg-webui/skill/core": ["packages/skill/core.ts"],
      "@amg-webui/skill": ["packages/skill/index.ts"],
      "@amg-webui/theme/core": ["packages/theme/core.ts"],
      "@amg-webui/theme": ["packages/theme/index.ts"],
      "@amg-webui/icons": ["packages/icons/index.ts"],
      "@amg-webui/utils": ["packages/utils/index.ts"],
      "@amg-webui/types": ["packages/types/index.ts"],
      "@amg-webui/locale": ["packages/locale/index.ts"],
      "amg-webui": ["packages/index.ts"],
      "amg-webui/*": ["packages/*"],
      "amg-webui/core": ["packages/components/core/index.ts"],
      "amg-webui/core/*": ["packages/components/core/*"],
      "amg-webui/form": ["packages/components/form/index.ts"],
      "amg-webui/form/*": ["packages/components/form/*"],
      "amg-webui/hooks": ["packages/hooks/index.ts"],
      "amg-webui/locale": ["packages/locale/index.ts"],
      "amg-webui/theme": ["packages/theme/index.ts"],
      "amg-webui/icons": ["packages/icons/index.ts"],
      "@amg-webui/constants": ["packages/constants/index.ts"],
      "@amg-webui/animations": ["packages/animations/index.ts"],
      "@/*": ["packages/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.vue",
    "example/**/*.ts",
    "example/**/*.vue",
    "example/env.d.ts"
  ],
  "exclude": [
    "example/**/snippets/**"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
