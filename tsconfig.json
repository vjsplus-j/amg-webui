{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@amg-webui": ["packages/index.ts"],
      "@amg-webui/*": ["packages/*"],
      "@amg-webui/components": ["packages/components/index.ts"],
      "@amg-webui/components/base": ["packages/components/base/index.ts"],
      "@amg-webui/components/business": ["packages/components/business/index.ts"],
      "@amg-webui/hooks": ["packages/hooks/index.ts"],
      "@amg-webui/telemetry": ["packages/telemetry/index.ts"],
      "@amg-webui/security": ["packages/security/index.ts"],
      "@amg-webui/lowcode": ["packages/lowcode/index.ts"],
      "@amg-webui/skill/core": ["packages/skill/core.ts"],
      "@amg-webui/skill": ["packages/skill/index.ts"],
      "@amg-webui/theme/core": ["packages/theme/core.ts"],
      "@amg-webui/theme": ["packages/theme/index.ts"],
      "@amg-webui/icons": ["packages/icons/index.ts"],
      "@amg-webui/utils": ["packages/utils/index.ts"],
      "@amg-webui/types": ["packages/types/index.ts"],
      "@amg-webui/locale": ["packages/locale/index.ts"],
      "@amg-webui/constants": ["packages/constants/index.ts"],
      "@amg-webui/animations": ["packages/animations/index.ts"],
      "@/*": ["packages/*"]
    }
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "packages/**/*.vue",
    "example/**/*.ts",
    "example/**/*.vue",
    "example/env.d.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
